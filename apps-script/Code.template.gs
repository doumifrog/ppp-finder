/**
 * Parent Possible Program Finder: interest form backend.
 *
 * Paste this whole file into Extensions > Apps Script in the "Program Finder
 * interest forms" Google Sheet, then deploy it as a web app.
 * Each request is saved as a row in the sheet, then emailed to the site with
 * Parent Possible on CC.
 *
 * Generated by scripts/build.py from apps-script/Code.template.gs. To change
 * the site list, rebuild instead of editing SITE_EMAILS by hand.
 */

// ---- Settings ---------------------------------------------------------------

// While TEST_MODE is true, every email goes ONLY to TEST_EMAIL, never to a real
// site or to Parent Possible. Set it to false only when Parent Possible is ready.
var TEST_MODE = true;
var TEST_EMAIL = '__TEST_EMAIL__';

// Parent Possible's intake inbox. It is CC'd on every request, and requests for
// sites with no email on file go straight to it.
var INTAKE_EMAIL = '__INTAKE_EMAIL__';

// Safety cap so a spammer can't use up the account's daily email quota.
var MAX_PER_HOUR = 30;

// Site id -> site name, program, email. Built from data/sites.json.
var SITES = __SITES__;

var HEADERS = [
  'Received', 'Status', 'Program', 'Site', 'Sent to', 'County', 'Filled out by',
  'Name', 'Best way to reach', 'Phone', 'Email', "Child's age", 'Preferred language',
  'Best time', 'Referrer name', 'Referrer organization', 'Note', 'Form language', 'Followed up?'
];

// ---- Web app ----------------------------------------------------------------

function doGet() {
  return json_({ ok: true, message: 'Program Finder form backend is running.', testMode: TEST_MODE });
}

function doPost(e) {
  try {
    var d = JSON.parse((e && e.postData && e.postData.contents) || '{}');

    // Honeypot: real visitors never see or fill the "company" field. Bots do.
    if (d.company) return json_({ ok: true });

    var site = SITES[String(d.siteId)];
    if (!site) return json_({ ok: false, error: 'unknown_site' });

    var name = clean_(d.name, 80);
    var how = ['Phone call', 'Text message', 'Email'].indexOf(d.how) >= 0 ? d.how : 'Phone call';
    var phone = clean_(d.phone, 40);
    var email = clean_(d.email, 120);
    if (!name) return json_({ ok: false, error: 'missing_name' });
    if (how === 'Email' && !/^\S+@\S+\.\S+$/.test(email)) return json_({ ok: false, error: 'bad_email' });
    if (how !== 'Email' && phone.replace(/\D/g, '').length < 10) return json_({ ok: false, error: 'bad_phone' });
    if (d.consent !== true) return json_({ ok: false, error: 'no_consent' });

    if (!underRateLimit_()) return json_({ ok: false, error: 'busy' });

    var r = {
      county: clean_(d.county, 40),
      who: d.who === 'worker' ? 'Caseworker or provider' : 'Parent or caregiver',
      name: name, how: how, phone: phone, email: email,
      kids: clean_(d.kids, 80), language: clean_(d.language, 40), time: clean_(d.time, 40),
      workerName: d.who === 'worker' ? clean_(d.workerName, 80) : '',
      workerOrg: d.who === 'worker' ? clean_(d.workerOrg, 120) : '',
      note: clean_(d.note, 1000), formLanguage: d.formLanguage === 'es' ? 'Spanish' : 'English'
    };

    var realTo = site.email || INTAKE_EMAIL;
    var status = TEST_MODE ? 'Test (sent to ' + TEST_EMAIL + ')' : 'Emailed';

    var lock = LockService.getScriptLock();
    lock.waitLock(10000);
    try {
      var sheet = sheet_();
      // Write after the last filled "Received" cell rather than using appendRow,
      // so pre-made checkboxes in "Followed up?" don't push new rows to the bottom.
      var row = sheet.getRange('A:A').getValues().filter(function (v) { return v[0] !== ''; }).length + 1;
      sheet.getRange(row, 1, 1, HEADERS.length).setValues([[
        new Date(), status, site.program, site.name, realTo, r.county, r.who,
        r.name, r.how, r.phone, r.email, r.kids, r.language,
        r.time, r.workerName, r.workerOrg, r.note, r.formLanguage, ''
      ].map(safeCell_)]);
    } finally {
      lock.releaseLock();
    }

    sendEmail_(site, realTo, r);
    return json_({ ok: true, testMode: TEST_MODE });
  } catch (err) {
    console.error(err);
    return json_({ ok: false, error: 'server_error' });
  }
}

// ---- Helpers ----------------------------------------------------------------

function sendEmail_(site, realTo, r) {
  var lines = [
    'Hi ' + site.name + ' team,',
    '',
    'A ' + (r.who === 'Parent or caregiver' ? 'family' : 'referral') + ' came in through the Parent Possible Program Finder.',
    '',
    'Name: ' + r.name,
    'County: ' + (r.county || 'Not given'),
    "Child's age: " + (r.kids || 'Not given'),
    'Preferred language: ' + (r.language || 'Not given'),
    'Form filled out in: ' + r.formLanguage,
    'Best way to reach: ' + r.how,
    r.phone ? 'Phone: ' + r.phone : null,
    r.email ? 'Email: ' + r.email : null,
    'Best time: ' + (r.time || 'Any time'),
    r.workerName || r.workerOrg ? 'Referred by: ' + (r.workerName || 'Not given') + ', ' + (r.workerOrg || 'organization not given') : null,
    r.note ? 'Note: ' + r.note : null,
    '',
    site.email
      ? 'Parent Possible is copied and will check in if there is no follow-up within 3 business days.'
      : 'This site has no email on file, so Parent Possible will forward this request to the site.'
  ].filter(function (l) { return l !== null; });

  var subject = 'New family interested in ' + site.program + (r.county ? ' (' + r.county + ' County)' : '');
  var msg = { name: 'Parent Possible Program Finder', subject: subject, body: lines.join('\n') };
  if (r.email) msg.replyTo = r.email;

  if (TEST_MODE) {
    msg.to = TEST_EMAIL;
    msg.subject = '[TEST] ' + subject;
    msg.body = 'TEST MODE. In real use this would go to ' + realTo +
      (site.email ? ' with CC to ' + INTAKE_EMAIL : '') + '.\n\n' + msg.body;
  } else {
    msg.to = realTo;
    if (site.email) msg.cc = INTAKE_EMAIL;
  }
  MailApp.sendEmail(msg);
}

function sheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName('Requests') || ss.insertSheet('Requests');
  if (sheet.getLastRow() === 0) {
    sheet.appendRow(HEADERS);
    sheet.setFrozenRows(1);
    sheet.getRange(1, 1, 1, HEADERS.length).setFontWeight('bold');
  }
  return sheet;
}

function underRateLimit_() {
  var cache = CacheService.getScriptCache();
  var key = 'count_' + Math.floor(Date.now() / 3600000);
  var n = Number(cache.get(key) || 0);
  if (n >= MAX_PER_HOUR) return false;
  cache.put(key, String(n + 1), 3700);
  return true;
}

function clean_(v, max) {
  return String(v == null ? '' : v).replace(/[\u0000-\u0008\u000b-\u001f]/g, '').trim().slice(0, max);
}

// Stop text like "=HYPERLINK(...)" from running as a spreadsheet formula.
function safeCell_(v) {
  return typeof v === 'string' && /^[=+\-@]/.test(v) ? "'" + v : v;
}

function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

// Run this once from the editor (select "authorize" and press Run) to grant
// permission for the sheet and email before deploying.
function authorize() {
  sheet_();
  MailApp.getRemainingDailyQuota();
}
